# 클로바 스피치 (STT, 장문 인식 도메인) — NCP 콘솔 > CLOVA Speech > 도메인 상세에서 확인
# CLOVA_INVOKE_URL: 콘솔에 표시된 Invoke URL 그대로 (끝의 /recognizer/upload는 코드가 붙임)
CLOVA_INVOKE_URL=
CLOVA_SECRET_KEY=

# LLM 게이트웨이 (건국대 API Gateway, Mindlogic) — AI_설계.md §2
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# 시작 후보(최저 비용). 정확도 테스트하며 조정 (gemini-3.5-flash-lite/3.7-flash/... )
LLM_GATEWAY_MODEL=gemini-3.5-flash-lite

# AWS — docs/aws.md
# 자격증명은 코드에 안 넣음. EC2 배포 시엔 backend(S3Config.java)와 동일하게
# DefaultCredentialsProvider 방식(boto3 기본 체인 = 인스턴스 IAM role 자동 사용) 예정.
# 로컬 개발 중엔 `coach-ai` IAM 유저의 access key를 `aws configure`로 별도 설정해야 함.
AWS_REGION=ap-northeast-2
S3_BUCKET=
SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/392921963367/presentation-coach-jobs

# Spring 콜백 (API_명세서 §3.2) — 2026-09-07 기준 docs/aws.md(깃허브)에서 확인:
# 아직 CloudFront 없이 EC2 IP:포트로 직접 연결.
CALLBACK_URL=http://54.116.144.17:8080/api/internal/analysis-results
WORKER_SECRET=
